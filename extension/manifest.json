{
  "manifest_version": 3,
  "name": "Edie Cursor",
  "version": "0.2.0",
  "description": "An agent cursor that follows a clinician-patient conversation and suggests values for the form field being discussed. Prototype, synthetic data only.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open Edie Cursor", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "sidepanel/panel.html" },
  "permissions": ["sidePanel"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:8000/mock/*"],
      "js": ["content/agent.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2"], "matches": ["http://localhost:8000/*"] }
  ]
}
